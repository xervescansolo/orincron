# ─────────────────────────────────────────────
#  OrinCron — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Your Discord bot token (required)
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord user ID (required for owner commands)
# Enable Developer Mode in Discord settings, right-click your name, Copy ID
OWNER_ID=your_discord_user_id_here

# Bot prefix for text commands (optional, default is +)
BOT_PREFIX=+
